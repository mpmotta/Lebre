incluir "conexao.leb";

classe Pessoa estende Conexao {
    privado var texto #tabela;
    privado var texto #nome;
    privado var texto #fone;
    privado var texto #email;
    
    funcao construtor() {
        #tabela = "contatos";
    }

    publico funcao getNome() { retorna #nome; }
    publico funcao setNome(texto #n) { #nome = #n; }
    
    publico funcao getFone() { retorna #fone; }
    publico funcao setFone(texto #f) { #fone = #f; }
    
    publico funcao getEmail() { retorna #email; }
    publico funcao setEmail(texto #e) { #email = #e; }
    
    publico funcao consulta() {
        var texto #sql = "SELECT * FROM ${#tabela}";
        var texto #json = mysqlConsultar(#sql);
        retorna #json;
    }
    
    publico funcao consultaID(texto #valorId) {
        var texto #sql = "SELECT * FROM ${#tabela} WHERE id = ${#valorId}";
        var texto #json = mysqlConsultar(#sql);
        retorna #json;
    }
    
    publico funcao inserir() {
        var texto #sql = "INSERT INTO ${#tabela} (nome, fone, email) VALUES ('${#nome}', '${#fone}', '${#email}')";
        var texto #json = mysqlConsultar(#sql);
        retorna #json;
    }
    
    publico funcao editar(texto #valorId) {
        var texto #sql = "UPDATE ${#tabela} SET nome = '${#nome}', fone = '${#fone}', email = '${#email}' WHERE id = ${#valorId}";
        var texto #json = mysqlConsultar(#sql);
        retorna #json;
    }
    
    publico funcao excluir(texto #valorId) {
        var texto #sql = "DELETE FROM ${#tabela} WHERE id = ${#valorId}";
        var texto #json = mysqlConsultar(#sql);
        retorna #json;
    }
}
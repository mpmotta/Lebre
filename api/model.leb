incluir "conexao.leb";

classe Pessoa estende Conexao {
    var privada texto #tabela;
    var privada texto #nome;
    var privada texto #fone;
    var privada texto #email;
    
    funcao construtor() {
        #tabela = "contatos";
    }

    funcao publica pegaNome() { retorna #nome; }
    funcao publica setaNome(texto #n) { #nome = #n; }
    
    funcao publica pegaFone() { retorna #fone; }
    funcao publica setaFone(texto #f) { #fone = #f; }
    
    funcao publica pegaEmail() { retorna #email; }
    funcao publica setaEmail(texto #e) { #email = #e; }
    
    funcao publica consulta() {
        var texto #sql = "SELECT * FROM {{#tabela}}";
        var texto #json = mysqlConsultar(#sql);
        retorna #json;
    }
    
    funcao publica consultaID(texto #valorId) {
        var texto #sql = "SELECT * FROM {{#tabela}} WHERE id = {{#valorId}}";
        var texto #json = mysqlConsultar(#sql);
        retorna #json;
    }
    
    funcao publica inserir() {
        var texto #sql = "INSERT INTO {{#tabela}} (nome, fone, email) VALUES ('{{#nome}}', '{{#fone}}', '{{#email}}')";
        var texto #json = mysqlConsultar(#sql);
        retorna #json;
    }
    
    funcao publica editar(texto #valorId) {
        var texto #sql = "UPDATE {{#tabela}} SET nome = '{{#nome}}', fone = '{{#fone}}', email = '{{#email}}' WHERE id = {{#valorId}}";
        var texto #json = mysqlConsultar(#sql);
        retorna #json;
    }
    
    funcao publica excluir(texto #valorId) {
        var texto #sql = "DELETE FROM {{#tabela}} WHERE id = {{#valorId}}";
        var texto #json = mysqlConsultar(#sql);
        retorna #json;
    }
}
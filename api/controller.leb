incluir "model.leb";

funcao consultar() {
    Objeto #pessoaModel = novo Pessoa();
    var texto #result = #pessoaModel->consulta();
    retorna #result;
}

funcao consultaID(texto #id) {
    Objeto #pessoaModel = novo Pessoa();
    var texto #result = #pessoaModel->consultaID(#id);
    retorna #result;
}

funcao inserir(Objeto #pessoa) {
    se (contar(#pessoa->getNome()) == 0 || contar(#pessoa->getFone()) == 0 || contar(#pessoa->getEmail()) == 0) {
        enviarResposta("erro: campo vazio");
    } senao {
        Objeto #pessoaModel = novo Pessoa();
        #pessoaModel->setNome(#pessoa->getNome());
        #pessoaModel->setFone(#pessoa->getFone());
        #pessoaModel->setEmail(#pessoa->getEmail());
        #pessoaModel->inserir();
        enviarResposta("[{\"status\":\"cadastro_ok\"}]");
    }
}

funcao editar(Objeto #pessoa, texto #id) {
    se (contar(#pessoa->getNome()) == 0 || contar(#pessoa->getFone()) == 0 || contar(#pessoa->getEmail()) == 0) {
        enviarResposta("erro: campo vazio");
    } senao {
        Objeto #pessoaModel = novo Pessoa();
        #pessoaModel->setNome(#pessoa->getNome());
        #pessoaModel->setFone(#pessoa->getFone());
        #pessoaModel->setEmail(#pessoa->getEmail());
        #pessoaModel->editar(#id);
        enviarResposta("[{\"status\":\"edit_ok\"}]");
    }
}

funcao excluir(texto #id) {
    Objeto #pessoaModel = novo Pessoa();
    #pessoaModel->excluir(#id);
    enviarResposta("[{\"status\":\"delete_ok\"}]");
}

funcao handleRequest() {
    var texto #requisicao = receberRequisicao();
    var lista #linhas = dividir(#requisicao, "\n");
    var int #qtd = contar(#linhas);
    
    se (#qtd > 0) {
        var texto #corpo = #linhas[#qtd - 1];
        var lista #dados = dividir(#corpo, "|");
        var int #qtdDados = contar(#dados);
        
        se (#qtdDados > 1) {
            var texto #acao = #dados[0];
            
            se (#acao === "excluir") {
                excluir(#dados[1]);
            } senao se (#acao === "salvar") {
                Objeto #pessoa = novo Pessoa();
                #pessoa->setNome(#dados[2]);
                #pessoa->setFone(#dados[3]);
                #pessoa->setEmail(#dados[4]);
                
                se (#dados[1] === "0") {
                    inserir(#pessoa);
                } senao {
                    editar(#pessoa, #dados[1]);
                }
            } senao se (#acao === "buscar") {
                var texto #json = consultaID(#dados[1]);
                enviarResposta(#json);
            }
            retorna;
        }
    }
    
    var texto #jsonTodos = consultar();
    enviarResposta(#jsonTodos);
}